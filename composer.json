{
    "name": "pixelweb/php-zatca-qr",
    "description": "Encode the ZATCA Phase 1 QR payload for Saudi tax invoices: TLV plus Base64, with no dependencies.",
    "keywords": ["zatca", "qr", "invoice", "saudi-arabia", "vat", "tlv", "e-invoicing", "fatoora"],
    "homepage": "https://github.com/Tarikdevinfo/php-zatca-qr",
    "license": "MIT",
    "authors": [
        {
            "name": "Tarik Leghnimi El Idrissi",
            "email": "tarikkelidrissi@gmail.com",
            "homepage": "https://pixelweb.ma"
        }
    ],
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "phpstan/phpstan": "^1.10",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "Pixelweb\\ZatcaQr\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pixelweb\\ZatcaQr\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "lint": "phpcs",
        "check": ["@lint", "@analyse", "@test"]
    },
    "config": {
        "sort-packages": true
    }
}
